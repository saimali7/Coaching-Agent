# API
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Host port the production Docker Compose stack publishes the app on
WEB_PORT=8080

# Host ports for the hot reloading dev stack (docker-compose.dev.yml)
WEB_DEV_PORT=5173
API_PORT=3000

# Where the Vite dev server proxies /api (dev only, never sent to the browser)
API_PROXY_TARGET=http://localhost:3000

# Absolute API origin baked into the client bundle. Leave empty to call /api on the
# same origin, which is what both the dev proxy and the nginx container expect.
VITE_API_URL=

# ElevenLabs (voice agent + TTS cue generation). Server-side only, never sent to the browser.
ELEVENLABS_API_KEY=
# Conversational AI agent id — created/written by `npm run agent:create`
ELEVENLABS_AGENT_ID=
# Voice used for the agent and pre-generated cues (default: George)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Absolute path to the built frontend the API serves in single-origin mode. Leave empty
# to use apps/web/dist; when no build is there the API serves the API only.
WEB_DIST=

# Tunnel hostname (no scheme) for running the Vite dev server behind ngrok. Dev only.
TUNNEL_HOST=
