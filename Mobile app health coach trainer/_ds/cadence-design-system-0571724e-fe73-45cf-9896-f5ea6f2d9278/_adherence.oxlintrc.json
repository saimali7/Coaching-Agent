        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|color|height|label|valueLabel|segments|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, max, color, height, label, valueLabel, segments, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScaleGauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|ticks|minLabel|midLabel|maxLabel|color|display|height|style|key|ref|className|style|children)$/]",
        "message": "<ScaleGauge> doesn't accept that prop. Declared props: value, min, max, ticks, minLabel, midLabel, maxLabel, color, display, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|size|fullWidth|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, size, fullWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<SegmentedControl> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|options|disabled|hint|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, value, onChange, options, disabled, hint, style."
