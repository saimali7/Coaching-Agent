{
  "name": "coaching-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace @coaching-agent/api",
    "dev:web": "npm run dev --workspace @coaching-agent/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run start --workspace @coaching-agent/api",
    "agent:create": "node scripts/create-agent.mjs",
    "cues:generate": "node scripts/generate-cues.mjs",
    "docker": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down"
  },
  "engines": {
    "node": ">=20"
  }
}
