# Shared dev image for both workspaces. Dependencies are installed at build time so the
# containers start instantly and never race each other over a shared node_modules volume.
FROM node:22.22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci
COPY . .
